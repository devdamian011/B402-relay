# Copy to .env and fill in real values locally. Never commit the filled-in file.

PORT=4000

# Supabase (server-side — service role key, keep off the client bundle)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Binance Agent OS MCP
BINANCE_AGENT_MCP_URL=https://agent.binance.com/mcp/agentic

# --- Testnet credentials (default for every session, per Section 9.2) ---
BINANCE_TESTNET_CLIENT_ID=
BINANCE_TESTNET_ACCESS_TOKEN=
BINANCE_TESTNET_PRIVATE_KEY_B64=

# --- Mainnet credentials (DO NOT set outside an explicit go-live session) ---
BINANCE_MAINNET_CLIENT_ID=
BINANCE_MAINNET_ACCESS_TOKEN=
BINANCE_MAINNET_PRIVATE_KEY_B64=

# Which credential set the API should load — flips only in an explicit go-live session
BINANCE_ENV=testnet
